# Dynamic QR — plantilla de variables de entorno.
# Copia a `.env` (git-ignorado) y rellena. NUNCA subas secretos reales.
# Local: los valores salen de la salida de `supabase start` (o `supabase status`).
# Staging/producción: dashboard de Supabase del proyecto; en Vercel van como
# env vars del proyecto, nunca en el repo. Ver docs/07-deploy.md.

# ─────────────────────────────────────────────
# API servidor (apps/api) — NO exponer al navegador
# ─────────────────────────────────────────────

# URL del proyecto. Local: API URL de `supabase start`.
# Staging/prod: Settings → API → Project URL.
SUPABASE_URL=http://127.0.0.1:54321

# Clave anon (pública, sujeta a RLS). Local: `anon key` de `supabase start`.
# Staging/prod: Settings → API → anon / publishable key.
SUPABASE_ANON_KEY=

# SOLO SERVIDOR. Omite RLS; solo redirector y jobs internos. Nunca en el cliente.
# Local: `service_role key` de `supabase start`. Staging/prod: Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# SOLO SERVIDOR. Verifica los JWT de Supabase.
# Local: `JWT secret` de `supabase start`. Staging/prod: Settings → API → JWT Secret.
SUPABASE_JWT_SECRET=

# Base pública del redirector (los QR apuntan aquí).
# Local: http://localhost:8000. Prod: https://<dominio-corto>
PUBLIC_REDIRECT_BASE_URL=http://localhost:8000

# SOLO SERVIDOR. Sal para hashear IPs; genera una distinta por entorno:
#   openssl rand -hex 32
IP_HASH_SALT=

# ─────────────────────────────────────────────
# Web pública (apps/web) — NEXT_PUBLIC_* queda expuesto al navegador
# ─────────────────────────────────────────────

# Mismos valores públicos que SUPABASE_URL / SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de la API FastAPI. Local: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
